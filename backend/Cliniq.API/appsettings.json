{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../Cliniq.DataAccess/cliniq.db"
  },
  "JwtOptions": {
    "Issuer": "Cliniq.API",
    "Audience": "Cliniq.Client",
    "Lifetime": 60
  },
  "Swagger": {
    "Application": {
      "Title": "Cliniq API",
      "Description": "HTTP API for Cliniq clinic services.",
      "Version": "v1"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
